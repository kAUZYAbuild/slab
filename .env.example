# LIVE=1 broadcasts real transactions. Anything else is paper mode.
LIVE=
DB_PATH=./data/slab.db
PORT=4877

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# base58 or JSON byte array. Not needed in paper mode.
SLAB_PRIVATE_KEY=
# receives the monthly hosting reimbursement
OPS_WALLET=
# protects POST /api/ack-drift
ADMIN_TOKEN=

# comps
PPT_KEY=
PPT_DAILY_BUDGET=80

# inference (UsePod x402)
USEPOD_MODEL=
LLM_DAILY_CAP_U=2000000

# clawpump (display only)
CLAWPUMP_KEY=
CLAWPUMP_AGENT_ID=

# SP3ND (physical route). Register with scripts/sp3nd-register.mjs. SHIP_TO is the
# vault address for a deposit you have already opened on Collector Crypt.
SP3ND_API_KEY=
SP3ND_API_SECRET=
SP3ND_EMAIL=
SP3ND_SHIP_TO={"name":"","recipient":"","address1":"","address2":"","city":"","state":"","postalCode":"","country":"United States","countryCode":"US","phone":""}
